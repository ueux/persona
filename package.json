  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ueux/persona/issues"
  },
  "homepage": "https://github.com/ueux/persona#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
